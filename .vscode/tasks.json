{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docs: Serve (live reload)",
      "type": "shell",
      "command": "bundle exec jekyll serve --watch --livereload --force_polling",
      "options": {
        "cwd": "${workspaceFolder}/docs",
        "env": {
          "LISTEN_FORCE_POLLING": "1"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "label": "Docs: Serve (live reload)"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)(error|warning)(.*)$",
          "file": 1,
          "severity": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Generating\\.\\.\\.",
          "endsPattern": "^.*LiveReload address:"
        }
      }
    }
  ]
}
